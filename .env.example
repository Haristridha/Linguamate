# Telegram
TELEGRAM_BOT_TOKEN=            # dari @BotFather
TELEGRAM_WEBHOOK_SECRET=       # string acak, untuk verifikasi webhook

# Groq API
GROQ_API_KEY=
# Dicoba berurutan: kalau model pertama kena rate limit (429), otomatis
# pindah ke model berikutnya dalam daftar ini.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3-27b

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # jangan pernah expose ke client, hanya dipakai di server

# Cron
CRON_SECRET=                   # string acak untuk melindungi endpoint /api/cron/*

# App
APP_TIMEZONE_DEFAULT=Asia/Jakarta
